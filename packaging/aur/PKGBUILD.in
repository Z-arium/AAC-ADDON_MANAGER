# Maintainer: Z-arium <https://github.com/Z-arium>
# Generated by packaging/aur/make-pkgbuild.sh from the release AppImage; edit PKGBUILD.in, not the copy on the AUR.
pkgname=archeage-classic-linux-launcher-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Gets ArcheAge Classic running on Linux (Wine/Proton fixes, crash help) and keeps its addons up to date"
arch=('x86_64')
url="https://github.com/Z-arium/AAC-ADDON_MANAGER"
license=('LicenseRef-AAC-Linux-Launcher')
depends=('ca-certificates' 'dbus' 'fontconfig' 'hicolor-icon-theme' 'libglvnd' 'libxkbcommon')
optdepends=(
  'fuse2: start the official launcher AppImage directly instead of in extract mode'
  'vulkan-icd-loader: the game renders through DXVK on Vulkan'
  'lib32-vulkan-icd-loader: 32-bit Vulkan for the 32-bit game (multilib)'
  'lib32-mesa: 32-bit OpenGL and Mesa Vulkan drivers (multilib)'
  'libnotify: a warning over the game when it nears its 4 GB memory limit'
)
provides=('archeage-classic-linux-launcher' 'aacam')
conflicts=('archeage-classic-linux-launcher' 'aacam')
options=('!strip' '!debug')
_appimage="ArcheAge-Classic-Linux-Launcher-x86_64.AppImage"
source=("${pkgname}-${pkgver}.AppImage::${url}/releases/download/v${pkgver}/${_appimage}")
noextract=("${pkgname}-${pkgver}.AppImage")
sha256sums=('@SHA256@')

prepare() {
  rm -rf squashfs-root
  chmod +x "${pkgname}-${pkgver}.AppImage"
  # Extracting needs no FUSE; the package runs the extracted program, never the AppImage.
  "./${pkgname}-${pkgver}.AppImage" --appimage-extract >/dev/null
}

package() {
  local dest=/opt/archeage-classic-linux-launcher
  install -d "${pkgdir}${dest}"
  cp -a squashfs-root/usr/bin/. "${pkgdir}${dest}/"
  chmod -R u=rwX,go=rX "${pkgdir}${dest}"

  install -d "${pkgdir}/usr/bin"
  printf '#!/bin/sh\nexec %s/aac-linux-launcher "$@"\n' "$dest" > "${pkgdir}/usr/bin/aac-linux-launcher"
  printf '#!/bin/sh\nexec %s/aac-linux-launcher cli "$@"\n' "$dest" > "${pkgdir}/usr/bin/aacam"
  chmod 755 "${pkgdir}/usr/bin/aac-linux-launcher" "${pkgdir}/usr/bin/aacam"

  install -Dm644 squashfs-root/aac-linux-launcher.desktop "${pkgdir}/usr/share/applications/aac-linux-launcher.desktop"
  cp -a squashfs-root/usr/share/icons "${pkgdir}/usr/share/"
  chmod -R u=rwX,go=rX "${pkgdir}/usr/share/icons"
}
